FROM node:24-bookworm-slim AS web-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html tsconfig.json vite.config.js ./
COPY src ./src
COPY public ./public
RUN npm run typecheck && npm run build

FROM node:24-bookworm-slim AS backend
ENV NODE_ENV=production KALDER_API_HOST=0.0.0.0 KALDER_API_PORT=3001
WORKDIR /app
COPY --chown=node:node backend ./backend
RUN mkdir -p /app/.runtime/backend && chown -R node:node /app/.runtime
USER node
EXPOSE 3001
CMD ["node", "backend/server.mjs"]

FROM nginx:1.28-alpine AS web
COPY nginx/home.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/dist /usr/share/nginx/html
EXPOSE 80
